# Copy to .env and fill in the secret values. Never commit .env.

# Core
KB_COLLECTION=cuc_kb_v2
KB_DATA_DIR=./data
KB_EMBED_MODEL=BAAI/bge-small-zh-v1.5
KB_API_TOKEN=<set-me>
KB_PUBLIC_BASE_URL=
KB_FILE_OBJECT_PREFIX=cuc-kb/docs

# Query-side embedding. "fastembed" = local KB_EMBED_MODEL (must match the
# collection). "openai" = cloud endpoint below; the collection must have been
# built with the same EMBED_API_MODEL/KB_EMBED_DIM via scripts/batch_embed.py.
KB_EMBED_PROVIDER=fastembed
EMBED_API_BASE=https://dashscope.aliyuncs.com
EMBED_API_PATH=/compatible-mode/v1/embeddings
EMBED_API_MODEL=qwen3.7-text-embedding
# EMBED_API_KEY defaults to RERANK_API_KEY when empty
EMBED_API_KEY=<set-me>
EMBED_API_TIMEOUT=10
KB_EMBED_DIM=1024
KB_EMBED_QUERY_INSTRUCT=Given a Chinese university regulation search query, retrieve relevant passages that answer the query
# Query-embedding LRU size; identical queries skip one cloud round-trip. 0 disables.
KB_EMBED_QUERY_CACHE=2048

# Cache
FASTEMBED_CACHE=./.cache/fastembed
HF_HOME=./.cache/huggingface

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=<set-me>

# Rerank (production: Bailian qwen3-rerank, see eval/ab/report_rr2.md)
KB_RERANK_PROVIDER=openai
KB_RERANK_MODEL=BAAI/bge-reranker-base
KB_RERANK_MIN_SCORE=0.75
KB_RERANK_ALWAYS=1
KB_RERANK_TRIGGER=0.58
KB_RERANK_LONG_TRIGGER=0.75
KB_RERANK_LONG_MIN_CHARS=6
KB_RERANK_SHORTLIST=20
# Local CPU fallback is too slow on the ARM host (~17 s/query); on cloud failure
# the request falls back to the un-reranked hybrid order instead.
KB_RERANK_LOCAL_FALLBACK=0
RERANK_API_BASE=https://dashscope.aliyuncs.com
RERANK_API_PATH=/compatible-api/v1/reranks
RERANK_API_MODEL=qwen3-rerank
RERANK_API_HEADER=authorization
RERANK_API_KEY=<set-me>
RERANK_API_TIMEOUT=4

# P0/P1 ranking and answerability knobs
KB_GENERIC_RERANK_PENALTY=0.10
KB_GENERIC_RRF_FACTOR=0.85
KB_GENERIC_CLOSE_MARGIN=0.10
KB_CANDIDATE_POOL=40
KB_CANDIDATE_LIMIT=24
KB_MAX_CHUNKS_PER_DOC=16
KB_COVERAGE_BONUS=0.004
KB_COVERAGE_MAX_BONUS=0.03
KB_ANSWERABILITY_MAX_CONF=0.95
KB_CONTENT_ANSWERABILITY_MAX_CONF=0.97
KB_ANSWER_SPAN_WINDOW=50
# 0: answer-span check is reported only; no_answer comes from the rerank threshold
KB_ANSWERABILITY_OVERRIDE=0

# OCI object storage (PDF bucket)
KB_OCI_AUTH=instance_principal
KB_OCI_REGION=us-phoenix-1
KB_OCI_NAMESPACE=<set-me>
KB_OCI_BUCKET=<set-me>
KB_PAR_TTL=900

# Casdoor OIDC / session
KB_OIDC_ISSUER=
KB_OIDC_CLIENT_ID=<set-me>
KB_OIDC_CLIENT_SECRET=<set-me>
KB_OIDC_REDIRECT_URIS=
KB_SESSION_SECRET=<set-me>
KB_SESSION_COOKIE=kb_session
KB_SESSION_TTL=43200

# MCP service
KB_MCP_HOST=127.0.0.1
KB_MCP_PORT=8765
KB_MCP_TOKEN=<set-me>
# Optional: comma-separated overrides (defaults cover loopback + Docker gateways)
KB_MCP_ALLOWED_HOSTS=
KB_MCP_ALLOWED_ORIGINS=

# MCP Docker gateway forwarder (kb/mcp_gateway_proxy.py)
KB_MCP_PROXY_BIND_HOSTS=172.17.0.1,172.18.0.1,172.19.0.1,172.20.0.1
KB_MCP_PROXY_PORT=8765
KB_MCP_PROXY_TARGET_HOST=127.0.0.1
KB_MCP_PROXY_TARGET_PORT=8765
