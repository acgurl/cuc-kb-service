{
  "openapi": "3.0.3",
  "info": {
    "title": "CUC 知识库检索 API",
    "version": "1.0.0",
    "description": "中国传媒大学校内规章制度与常见问题知识库。回答校内制度、办事流程、FAQ 类问题前先调用 /v1/search。短问题先改写成完整中文问题；口语化或可能有多种叫法的问题可在同一次回复里并行发起多个不同问法的 /v1/search 调用，合并结果判断，任一找到直接回答即作答；no_answer=false 时基于原文回答；no_answer=true 时先改写成更完整、正式的问法重试一次。仍为 true 且 confidence ≥0.6 时，结果多为相关规定而非直接答案：只使用确实相关的原文，先说明“知识库中没有直接回答这个问题的内容”，再给出相关规定或办理渠道并标注出处，不得推断原文没写的具体数字、日期、地点或个人信息；仍为 true 且 confidence <0.6 时，说明知识库没有相关信息，不要基于结果作答。引用时使用 citation 中的 doc_title、doc_no、clause_no、page_start；citation.file_url 可直接打开原文并跳到 page_start 页，page_count 为文档总页数；citation.source_url 为原始出处链接（官网页面或 AIHub 文档），publish_date 为文档日期（可能仅年份，date_basis 说明依据），为空表示未标定，不得自行推断。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "本机或 SSH 隧道地址；云端 agent 请替换为可访问的 HTTPS 地址"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/search": {
      "post": {
        "operationId": "kb_search",
        "summary": "检索知识库",
        "description": "混合检索（向量 + BM25 + rerank），返回相关条款原文、出处和置信度。assistant 与 doc_type 可先通过 /v1/meta 获取。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "example": {
                "query": "学生公寓的床尺寸是多少？",
                "assistant": "中传小勤",
                "top_k": 5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "检索结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token 无效"
          }
        }
      }
    },
    "/v1/meta": {
      "get": {
        "operationId": "kb_meta",
        "summary": "读取知识库概况",
        "description": "返回文档数、知识块数、可用助手名和文档类型，用于选择检索过滤条件。",
        "responses": {
          "200": {
            "description": "知识库概况",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token 无效"
          }
        }
      }
    },
    "/v1/documents": {
      "get": {
        "operationId": "kb_documents",
        "summary": "列出文档",
        "description": "列出知识库全部文档及元数据，可确认某份制度是否在库中。",
        "responses": {
          "200": {
            "description": "文档列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentList"
                }
              }
            }
          },
          "401": {
            "description": "Token 无效"
          }
        }
      }
    },
    "/v1/documents/{doc_id}/chunks": {
      "get": {
        "operationId": "kb_document_chunks",
        "summary": "读取文档知识块",
        "description": "按 doc_id 返回文档原文知识块，用于核对引用、定位条款或补充上下文。三种定位方式互斥：chunk_id（命中块前后 before/after 个相邻块）、page/page_end（页码范围）、offset（顺序游标，配合 next_offset 翻页）；都不传时返回全文。",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chunk_id",
            "in": "query",
            "required": false,
            "description": "定位锚点：命中块的 chunk_id，返回其前后相邻块。与 page/offset 互斥。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "chunk_id 定位时向前多读的块数。",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 2
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "chunk_id 定位时向后多读的块数。",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 2
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "按页码定位。与 chunk_id/offset 互斥。",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page_end",
            "in": "query",
            "required": false,
            "description": "页码范围终点，须与 page 同用且不小于 page。",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "顺序读取的起始块序号（0 起）。",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "返回块数上限；缺省返回定位范围内的全部块。",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "文档知识块",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentChunks"
                }
              }
            }
          },
          "401": {
            "description": "Token 无效"
          },
          "404": {
            "description": "文档或锚点 chunk 不存在"
          },
          "422": {
            "description": "定位参数冲突或越界"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <KB_API_TOKEN>"
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "完整的中文检索问题；短问题或指代不清时先改写。"
          },
          "assistant": {
            "type": "string",
            "description": "按助手名过滤，例如“中传小勤”；共享文档始终可见。"
          },
          "doc_type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "按文档类型过滤，可传多个。"
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "返回条数。"
          },
          "trace": {
            "type": "boolean",
            "default": false,
            "description": "评测诊断用：返回 dense/BM25/融合/精排各阶段快照；默认关闭。"
          }
        },
        "required": [
          "query"
        ]
      },
      "Citation": {
        "type": "object",
        "properties": {
          "doc_title": {
            "type": "string"
          },
          "doc_no": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "clause_no": {
            "type": "string"
          },
          "page_start": {
            "type": "integer"
          },
          "page_end": {
            "type": "integer"
          },
          "section_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_file": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "description": "原始出处链接（官网页面或 AIHub 文档）；未标定时为空。"
          },
          "publish_date": {
            "type": "string",
            "description": "文档日期，ISO 日期或仅年份；未标定时为空。"
          },
          "date_basis": {
            "type": "string",
            "description": "日期依据：发布日期/文内日期/源页日期/文件名日期/文号年份/标题年份/无。"
          },
          "page_count": {
            "type": "integer",
            "description": "文档总页数。"
          },
          "file_url": {
            "type": "string",
            "description": "原文 PDF 公网链接，已带 #page=page_start 页锚点；QA 条目为空。"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "条款或问答原文。"
          },
          "score": {
            "type": "number",
            "description": "RRF 融合分数。"
          },
          "dense_score": {
            "type": "number"
          },
          "bm25_score": {
            "type": "number"
          },
          "rerank_score": {
            "type": "number",
            "nullable": true
          },
          "citation": {
            "$ref": "#/components/schemas/Citation"
          },
          "is_qa": {
            "type": "boolean"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "no_answer": {
            "type": "boolean",
            "description": "为 true 表示最高 rerank 分数低于阈值（0.75），结果不是可靠的直接答案。"
          },
          "confidence": {
            "type": "number",
            "description": "最高 rerank 分数。no_answer=true 时，≥0.6 通常是相关规定但没有直接答案，<0.6 视为无关。"
          },
          "took_ms": {
            "type": "integer"
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "chunks": {
            "type": "integer"
          },
          "documents": {
            "type": "integer"
          },
          "assistants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doc_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "doc_title": {
            "type": "string"
          },
          "doc_no": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "assistants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_file": {
            "type": "string"
          },
          "pages": {
            "type": "integer"
          },
          "chunks": {
            "type": "integer"
          },
          "file_url": {
            "type": "string",
            "description": "原文 PDF 公网链接。"
          },
          "source_url": {
            "type": "string",
            "description": "原始出处链接；未标定时为空。"
          },
          "publish_date": {
            "type": "string",
            "description": "文档日期，ISO 日期或仅年份；未标定时为空。"
          },
          "date_basis": {
            "type": "string",
            "description": "日期依据。"
          }
        }
      },
      "DocumentList": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          }
        }
      },
      "DocumentChunks": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "page_count": {
            "type": "integer"
          },
          "file_url": {
            "type": "string",
            "description": "原文 PDF 公网链接。"
          },
          "source_url": {
            "type": "string",
            "description": "原始出处链接；未标定时为空。"
          },
          "publish_date": {
            "type": "string",
            "description": "文档日期，ISO 日期或仅年份；未标定时为空。"
          },
          "date_basis": {
            "type": "string",
            "description": "日期依据。"
          },
          "total_chunks": {
            "type": "integer",
            "description": "文档知识块总数。"
          },
          "offset": {
            "type": "integer",
            "description": "本次返回窗口的起始块序号（0 起）。"
          },
          "returned": {
            "type": "integer",
            "description": "本次返回的块数。"
          },
          "next_offset": {
            "type": ["integer", "null"],
            "description": "继续顺序读取的下一块序号；null 表示已到文末。"
          },
          "anchor_index": {
            "type": ["integer", "null"],
            "description": "chunk_id 定位时锚点块的序号；其余定位方式为 null。"
          },
          "anchor_chunk_id": {
            "type": ["string", "null"],
            "description": "chunk_id 定位时传入的锚点 chunk_id。"
          },
          "page_range": {
            "type": ["array", "null"],
            "items": {
              "type": "integer"
            },
            "description": "page 定位时的页码范围 [page, page_end]。"
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "index": {
                  "type": "integer",
                  "description": "块在文档内的序号（0 起）。"
                },
                "chunk_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "clause_no": {
                  "type": "string"
                },
                "page_start": {
                  "type": "integer"
                },
                "page_end": {
                  "type": "integer"
                },
                "section_path": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_file": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
