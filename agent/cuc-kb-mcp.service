[Unit]
Description=CUC KB MCP HTTP endpoint
After=network-online.target cuc-kb.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cuc-kb
EnvironmentFile=/home/ubuntu/cuc-kb/.env
ExecStart=/home/ubuntu/cuc-kb/.venv-mcp/bin/python /home/ubuntu/cuc-kb/mcp_http_server.py
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
